# Hoops Germany – Umgebungsvariablen
# Diese Datei als Vorlage nach .env kopieren und mit echten Werten füllen.
# WICHTIG: .env NIEMALS committen (steht in .gitignore).

# MongoDB Verbindungsstring
MONGODB_URI=

# Secret für JWT-Signierung
SECRET_KEY=

# SMTP (Hostinger Webmail – info@hoopsgermany.de)
SMTP_USER=info@hoopsgermany.de
SMTP_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret zum Absichern der Cron-Endpunkte (z.B. notify-pending-results)
CRON_SECRET=

# Basis-URL (für OAuth-Redirects, E-Mail-Links)
NEXTAUTH_URL=https://hoopsgermany.de
